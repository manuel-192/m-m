#!/bin/bash
# Maintainer: manuel (see forum.endeavouros.com)

pkgname=stickburn
pkgdesc="GUI for burning ISO to USB stick with dd; includes safety checks."
url="https://github.com/manuel-192/m-m/raw/master/PKGBUILDs/$pkgname"
pkgver=26.9
pkgrel=1
arch=('any')
license=('GPL')
depends=(
    bash
    yad        # yad needed only by stickburn
)

source=(
    $pkgname           # USB burning app GUI
    $pkgname.desktop
    burn2dev
    find-usb-sticks
    iso-to-usb         # USB burning app CLI

    # translations
    btr_${pkgname}_en
    btr_${pkgname}_fi
)
sha512sums=('6cb1a1bf140121b43cc10bad99233586b05d074efd08aa694de24e6650f91f3aa50751b67c7f9b8bf2a403cce92789b7d4d5e139f7734f327a93114ea7ff848d'
            'c2932968c88963bedc923f2889cf44b114f4929d1ebfc2678655bb7e3b75a16d740e0f5276633b4233159ac304669aebb1204c6a30ebfeab02de7cdaab1515fa'
            'e625c61067602578dbdb83f59f355d06ef8dc453a86a7d2038bc6665a1c88ce6b1950d5d7bd1c3940bf53a4049a00dd89fb8f3892242c619606a9d40c226bd3a'
            '84288baeea536cfc30446425020310ff6f31fcfa436808ed09c7673171a9e37ecfc632f38faacd83b14beac5cd9ca3f0d7fd42ff54c534c4c6c3f7c452de8424'
            '27a4dadab2da0d2418afabf0a14cac00bc15463cd3d2404ceaf03440fc935343298cc30d22782b9469b959af41da97c3ae2af561c9d23c00a50688c0dfcc5542'
            '8aa98f4680aeb8cadbb1177b9ea803789f67c779a95ab482f654d0a11900601df902172070ad5c8bc32ed9ab64a81e75b99327b6fb644cbba4789de352b7eac6'
            '853f264ce8a96d1a823af28afc9269fdf9b55e3b0efe4f09bc3ef706b0ae39af90eff1bd29e1ade5f6bb74ee991070a75e3c8e8625a3a57213ab1326cf7da504')

package() {
    local src file
    for src in "${source[@]}" ; do
        file="${src##*/}"
        case "$file" in
            *.desktop)          install -Dm644 "$file"        "$pkgdir/usr/share/applications/$file" ;;
            btr_${pkgname}_*)   install -Dm644 "$file"        "$pkgdir/usr/share/endeavouros/translations/$file" ;;
            *)                  install -Dm755 "$file"        "$pkgdir/usr/bin/$file" ;;
        esac
    done
}
