# bash completion for am        -*- shell-script -*-

_am_listselector()
{
    local cur="$1"
    local list_elems_all="$2"

    local realcur="${cur##*,}"
    local prefix="${cur%$realcur}"
    local elems word

    for word in $list_elems_all
    do
        if ! [[ $prefix == *"$word"* ]]; then
            elems="$word $elems"
        fi
    done
    COMPREPLY=( $(compgen -P "$prefix" -W "$elems" -S ',' -- $realcur) )
    compopt -o nospace
}

_am_complete() {
    COMPREPLY=($(compgen -W "$1" -- "$cur"))
    [[ $COMPREPLY == *= ]] && compopt -o nospace
    compopt -o nosort
}

_am_repoarg() {  # fill 'repolist' array
    local supported_repos=""               # e.g. "repo1|repo2|repo3
    local given                            # will have user given reponame(s)
    supported_repos="$(echo $(pacman-conf --repo-list | grep -vP '^core|^extra|^multilib|^kde|^KDE|^gnome|^Gnome') | tr ' ' '|')"
    if [ "$supported_repos" ] ; then
        given="$(grep -wP "$supported_repos" <(printf "%s\n" "${words[@]}"))"
        if [ -z "$given" ] ; then
            # (ad hoc) check if current working dir matches the supported repos
            given="$(grep -wP "$supported_repos" <(echo "${PWD##*/}"))"
            [ -r "$given.db" ] || given=""
        fi
        if [ "$given" ] ; then
            # use only given repos, or "$PWD"
            readarray -t repolist < <(echo "$given")
        else
            # no given repos ==> use all supported repos
            readarray -t repolist < <(echo "$supported_repos" | tr '|' '\n')
        fi
    fi
}

_am_() 
{
    local cur prev words #cword split
    _init_completion -s || return

    local items=(EOS endeavouros endeavouros-testing-dev
                 MAN m-aur2 m-more2 m-m
                 local-repo)
    local opts=(
        --allow-downgrade     -ad
        --aursrc=
        --build               -b
        --dryrun-local        -n
        --dryrun              -nn
        --explain-hook-marks  -e
        --fetch-timeout=      -T=
        --no-aur
        --pkgdiff
        --pkgnames
        --repoup
    )

    # Handle options that need sub-options.
    # Each option "case" should return immediately.

    case "$prev" in
        --pkgnames)
            local repolist=()
            _am_repoarg
            _am_listselector "$cur" "$(pacman -Slq "${repolist[@]}")"
            ;;
        *)
            # Handle all top-level parameters.
            _am_complete "${items[*]} ${opts[*]}" ;;
    esac
} &&
complete -F _am_ am
