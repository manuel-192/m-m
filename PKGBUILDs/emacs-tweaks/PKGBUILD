source=(
    $url/emacs
    $url/em
    $url/emacsr
    $url/emacs-fix-position-for-kate
    $url/emacs-nw
    $url/emacs-readonly
    $url/emacs-session-setup
    $url/emacs.bash-template
    $url/emacs.bash-completion
)
