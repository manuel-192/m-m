#!/bin/bash

Main() {
    local -r appname=${0##*/}
    local apps=()        # The list of supported apps.
    local apps2=()
    local app
    local -r wrapperdir=/usr/local/bin
    local -r bindir=/usr/bin

    readarray -t apps  < <(/bin/ls -l "$wrapperdir" | /bin/grep -- " -> START_BG$" | /bin/awk '{print $(NF-2) }')
    readarray -t apps2 < <(/bin/ls -l "$wrapperdir" | /bin/grep -- " -> STOP$"     | /bin/awk '{print $(NF-2) }')

    case "$1" in
        -h | --help)
            echo2 "Options: -h, --help       This help"
            echo2 "         --apps           List of category 1 apps."
            echo2 "         --apps2          List of category 2 apps."
            exit 0
            ;;
        --apps)
            printf "%s\n" "${apps[@]}"
            exit 0
            ;;
        --apps2)
            printf "%s\n" "${apps2[@]}"
            exit 0
            ;;
    esac

    app=$(printf "%s\n" "${apps2[@]}" | /bin/grep -- "^$appname$")
    if [ "$app" ] && [ -x "$wrapperdir/$app" ] ; then
        eos-color info 2
        echo2 "==> $wrapperdir/STOP" "$@"
        eos-color reset 2
        $wrapperdir/STOP "$@"      # STOP is from package m-common!
        exit 0
    fi

    app=$(printf "%s\n" "${apps[@]}" | /bin/grep -- "^$appname$")
    if [ "$app" ] && [ -x "$wrapperdir/$app" ] ; then
        eos-color info 2
        echo2 "==> $bindir/$appname" "$@" "&"
        eos-color reset 2
        "$bindir/$appname" "$@" 2>/dev/null &
        exit 0
    else
        # Nothing matched so warn.
        eos-color error 2
        echo2 "==> $wrapperdir/$appname is not found"
        eos-color reset 2
        exit 1
    fi
}

echo2() { echo -e "$@" >&2; }

Main "$@"
