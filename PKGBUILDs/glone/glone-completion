# bash completion for glone        -*- shell-script -*-

_glone_complete() {
    COMPREPLY=($(compgen -W "$1" -- "$cur"))
    [[ $COMPREPLY == *= ]] && compopt -o nospace
}

_glone_complete_repos() {
    local GLONE_SITE=""
    local GLONE_ACCOUNT=""
    local GLONE_FILE_REPOS=""
    local GLONE_FILE_CONF="/etc/glone.conf"
    local repo_names=""

    source $GLONE_FILE_CONF || return 1
    repo_names="$(cat "$GLONE_FILE_REPOS")"

    COMPREPLY=( $(compgen -W "$repo_names" -- "$cur") )
}

_glone_() 
{
    local cur prev #words cword split
    _init_completion -s || return

    # Handle options that need sub-options.
    # Each option "case" should return immediately.

    case "$prev" in
        --account | -a)
            _glone_complete_repos ;;
        *)
            # Handle all top-level parameters.
            case "$cur" in
                -*)
                    # Any option or nothing yet.
                    ;;
                *)
                    # Non-option parameters.
                    _glone_complete_repos
                    ;;
            esac
            ;;
    esac
} &&
complete -F _glone_ glone
