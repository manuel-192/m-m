#!/bin/bash
# Maintainer: manuel (see forum.endeavouros.com)

pkgname=glone
pkgdesc="Very simple github repo cloner."
url="https://github.com/manuel-192/m-m/raw/master/PKGBUILDs/$pkgname"
pkgver=1
pkgrel=1.3

arch=('any')
license=('GPL')
depends=('bash')
backup=(etc/glone.conf)

source=(
    $url/$pkgname
    $url/$pkgname-completion
    $url/$pkgname.conf
)
sha512sums=('7b120166df68b723543f85183dbab1f1cb46d9620fa1f17e40d9e776ff5482c738901a9126d60f6aa49f1d3bb76578c36ef1a929d79b53714e5d39bba42ae5f6'
            '69261475b138b35e33bff9bb7fb0c4b33d16c493dff0aff38b2ac52ab3738befb6696501bab802cd8e165fe944b7b1895a03b946d73a60653142ac4ad9e33c0a'
            '0bc03ac2f0422403889430837fbfffdaeabbd386a1fca9e5d079e579c103f36fc6fbfc63e6fa100938ef95b7f385c745e1acbeb33d85ee87dd9cbab89cd5264a')

package() {
  install -Dm755 $pkgname                    $pkgdir/usr/bin/$pkgname
  install -Dm644 $pkgname-completion         $pkgdir/usr/share/bash-completion/completions/$pkgname
  install -Dm644 $pkgname.conf               $pkgdir/etc/$pkgname.conf
}
