# bash completion for arch-changelog        -*- shell-script -*-

_arch-changelog_complete() {
    # COMPREPLY=($(compgen -W "$1" -- "$cur"))
    readarray -t COMPREPLY < <(compgen -W "$1" -- "$cur")
    [[ ${COMPREPLY[0]} == *= ]] && compopt -o nospace
    compopt -o nosort
}

_arch-changelog_() 
{
    local cur prev #words #cword split
    _init_completion -s || return

    # Handle options that need sub-options.
    # Each option "case" should return immediately.

    case "$prev" in
        --clfile | -c)
            _filedir
            ;;
        *)
            # Handle all top-level parameters.
            case "$cur" in
                -*)
                    _arch-changelog_complete "$(/bin/arch-changelog --parameters)" ;;
                *)
                    # _arch-changelog_complete "$(/bin/pacman -Ssq)" ;;
                    # _arch-changelog_complete "$(/bin/yay -Pc | awk '{print $1}')"
                    _arch-changelog_complete "$(/bin/arch-changelog --pkgnames)"
                    ;;
            esac
    esac
} &&
complete -F _arch-changelog_ arch-changelog
