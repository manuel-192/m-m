#!/bin/bash
# Maintainer: manuel (see forum.endeavouros.com)

pkgname=arch-cl
pkgdesc="Arch packages changelog."
url="https://github.com/manuel-192/m-m/raw/master/PKGBUILDs/$pkgname"
pkgver=26.9
pkgrel=1
arch=('any')
license=('GPL')
depends=('bash')

source=(
    $url/arch-changelog
    $url/arch-changelog.completion
    $url/arch-changelog.conf
    $url/README.md
)

sha512sums=('e0cc68056e09aab0342df3c478a295cfd401069ea205a074852a4643ef877a2077bb2d5c5f9a3d914f85dcaf9b9ea1c1bc0f5fac50cd409af3f6fb9219a76733'
            '5d3c5e4ee8adae6103209e5b8a2945d539e2b4e57790009192b72cd0770178f3f7a3e78f6ba7b39f980c82ed2d8ff19f8b9772c441c2a9c251d4644ae4e8e731'
            '24c74f2386249318cc9d92c9312cdda675b149920b92230d710089edb2cf930bd0c56716d6e5a5475c0e1e7ed4769768118e1824484cbf28589b421be01b684d'
            '947766cdb1779fcf0db0225fa9cc1a930377e634cf4214693e961f84b445860fe81b48b0ba55b6860ea1634300696521e40757b49d144e055dc956a58ceda0dc')

package() {
    local src file
    for src in "${source[@]}" ; do
        file=${src##*/}
        case "$file" in
            *.completion) install -Dm644 $file    "$pkgdir/usr/share/bash-completion/completions/${file%.completion}" ;;
            *.conf)       install -Dm644 $file    "$pkgdir/etc/$file" ;;
            README.md)    install -Dm644 $file    "$pkgdir/usr/share/doc/$pkgname/arch-changelog.md" ;;
            *)            install -Dm755 $file    "$pkgdir/usr/bin/$file" ;;
        esac
    done
}
